{
  "name": "study-grove",
  "version": "1.0.0",
  "description": "A mobile study space for flashcards, vocabulary, and consistency challenges.",
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "dev": "vite --host 127.0.0.1",
    "server": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build && node scripts/build-sw.mjs",
    "icons": "node scripts/icons.mjs",
    "format": "prettier --write src server shared scripts tests *.json *.ts *.yaml README.md docs/*.md"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brunoalksouza/study-grove.git"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/brunoalksouza/study-grove/issues"
  },
  "homepage": "https://github.com/brunoalksouza/study-grove#readme",
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "fastify": "^5.12.8",
    "idb": "^8.0.4",
    "lucide-react": "^1.67.0",
    "papaparse": "^5.7.0",
    "pluralize": "8.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "ts-fsrs": "^6.0.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/pluralize": "0.0.33",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "fake-indexeddb": "^6.2.7",
    "fflate": "^0.8.3",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "private": true
}
