
# BEGIN ANKI BATTLE — isolated service; preserve every other vhost.
anki.aneblober.com {
    import cloudflare_only
    encode zstd gzip
    header {
        -Server
        X-Robots-Tag "noindex, nofollow"
        Strict-Transport-Security "max-age=31536000"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    }
    reverse_proxy anki-gateway:8080 {
        header_up X-Anki-IP {http.request.header.CF-Connecting-IP}
    }
}
# END ANKI BATTLE
